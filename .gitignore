# Ignore the .agents
.agents/
skills-lock.json
# Local Copilot config stays out of the repo; CI workflows are tracked.
.github/*
!.github/workflows/
plans/
.codex/
.instructions/
.claude/

# Ignore references to the .venv directory
.venv/
# Ignore the .vscode directory
.vscode/

# Ignore references
references-pbip/
references-ebook/
references-md/
research/

# Ignore the working files
_*.txt
_*.py
.scripts/
# Root-level sample PBIPs only. Script unit tests under skills/**/scripts/tests and scripts/tests are tracked.
/tests/

# Ignore generated artifacts (npm, Python cache, schema cache)
__pycache__/
.pytest_cache/
*.pyc
.schema-cache/
package-lock.json